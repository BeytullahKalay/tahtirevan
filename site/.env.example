# Canlı alan adı (canonical, hreflang, sitemap ve Open Graph için)
NEXT_PUBLIC_SITE_URL=https://tahtirevan.com

# Görüşme formu ve bülten başvurularının e-postayla iletilmesi (Resend HTTP API)
# Tanımlı değilse: geliştirme ortamında başvuru konsola yazılır, canlıda form hata döner.
RESEND_API_KEY=
# Başvuruların gideceği adres; boşsa hi@tahtirevan.com kullanılır.
CONSULTATION_TO_EMAIL=hi@tahtirevan.com
CONSULTATION_FROM_EMAIL=Tahtirevan <atelier@tahtirevan.com>

# Çerez onayından sonra yüklenen gizlilik dostu analitik (Plausible).
# Boş bırakılırsa çerez çubuğu da gösterilmez.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
